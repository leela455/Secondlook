# Copy this file to ".env" (Windows: copy .env.example .env) and edit the values.
# NEVER commit ".env".

NODE_ENV=development
PORT=5000

# Local MongoDB (default install). For MongoDB Atlas use the mongodb+srv:// string.
MONGODB_URI=mongodb://127.0.0.1:27017/secondlook

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Browser origins allowed to call the API when the frontend runs on another port.
# (Not needed when you open http://localhost:5000, where the backend serves the frontend itself.)
CLIENT_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
SERVE_FRONTEND=true

# Set to false to stop public sign-ups (admins can then not be created through the UI,
# so use `npm run seed` or create the first account before switching this off).
ALLOW_REGISTRATION=true

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limits
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=600

# Inspection provider.
#   demo = built-in MOCK provider. Scores are generated from the image bytes and are NOT real predictions.
#   http = calls your own model service (see docs/MODEL_INTEGRATION.md).
INSPECTION_PROVIDER=demo
MODEL_API_URL=
MODEL_API_KEY=
MODEL_API_TIMEOUT_MS=15000
