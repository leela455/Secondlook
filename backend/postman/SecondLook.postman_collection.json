      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "code",
      "value": "SL-1042"
    },
    {
      "key": "reviewId",
      "value": ""
    }
  ],
